# GitHub
# Public username — sudah default ke "Maliskandar" tanpa env ini.
GITHUB_USERNAME=Maliskandar
# Personal access token (opsional). Tanpa token, rate limit GitHub = 60 req/jam.
# Buat di https://github.com/settings/tokens — cukup scope "public_repo".
GITHUB_TOKEN=

# WakaTime
# Ambil di https://wakatime.com/api-key
WAKATIME_API_KEY=
# Biarkan "current" untuk pakai akun pemilik API key, atau ganti username publik
WAKATIME_USERNAME=current
